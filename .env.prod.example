# Modèle pour docker-compose.prod.yml. Copier en .env.prod sur la VM de déploiement.
# Les valeurs sensibles sont volontairement vides : ne jamais committer .env.prod.
# Utiliser un mot de passe PostgreSQL fort et compatible avec une URL, car
# docker-compose.prod.yml l'insère dans DATABASE_URL.

# Obligatoires pour Docker Compose et l'API de production.
POSTGRES_PASSWORD=
JWT_SECRET=

# JWT_SECRET doit avoir au moins 32 caractères. MFA_ENCRYPTION_KEY doit contenir
# exactement 64 caractères hexadécimaux si MFA_POLICY n'est pas disabled.
MFA_POLICY=optional
MFA_ENCRYPTION_KEY=

# Adapter l'origine publique du frontend. L'URL ci-dessous est un exemple inactif.
CORS_ORIGINS=https://example.invalid
ALLOW_SELF_REGISTER=false

# LDAP est optionnel ; renseigner ces variables seulement si LDAP est activé.
LDAP_ENABLED=false
# LDAP_URL=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=
# LDAP_SEARCH_FILTER=
# LDAP_ADMIN_GROUP=
# LDAP_EDITOR_GROUP=
# LDAP_INSECURE_TLS=false
